{
  "name": "@apirequest/data",
  "version": "0.4.4",
  "description": "Data Types, Validations and Migrations for API Request Public Data Structures",
  "type": "module",
  "main": "dist/apirequest-data.cjs",
  "module": "dist/apirequest-data.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist/*"
  ],
  "scripts": {
    "dev": "vite build --watch",
    "build:code": "vite build",
    "build:decl": "tsc --project tsconfig.decl.json",
    "build": "pnpm run build:code && pnpm run build:decl",
    "prepare": "pnpm run build:code && pnpm run build:decl",
    "do-typecheck": "pnpm exec tsc --noEmit"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/apirequest-data.js",
      "require": "./dist/apirequest-data.cjs"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lsy2246/apirequest.git"
  },
  "author": "API Request contributors",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/lsy2246/apirequest/issues"
  },
  "homepage": "https://github.com/lsy2246/apirequest#readme",
  "devDependencies": {
    "@types/lodash": "4.17.25",
    "typescript": "5.9.3",
    "vite": "7.3.2"
  },
  "dependencies": {
    "fp-ts": "2.16.11",
    "io-ts": "2.2.22",
    "jose": "6.2.10",
    "lodash": "4.18.1",
    "parser-ts": "0.7.0",
    "uuid": "13.0.0",
    "verzod": "0.4.0",
    "zod": "3.25.32"
  }
}

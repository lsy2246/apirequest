{
  "name": "@apirequest/runner",
  "version": "0.31.4",
  "description": "Automation execution library for apirequest",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "do-build-prod": "tsup",
    "do-typecheck": "tsc --noEmit",
    "do-test": "vitest run src/__tests__/unit/workbench-automation.spec.ts"
  },
  "license": "MIT",
  "private": true,
  "dependencies": {
    "aws4fetch": "1.0.20",
    "axios": "1.20.0",
    "axios-cookiejar-support": "6.0.5",
    "chalk": "5.6.2",
    "graphql": "16.13.2",
    "js-md5": "0.8.3",
    "jsonc-parser": "3.3.1",
    "lodash-es": "4.18.1",
    "papaparse": "5.6.0",
    "qs": "6.16.0",
    "semver": "7.8.5",
    "tough-cookie": "6.0.2",
    "verzod": "0.4.0",
    "xmlbuilder2": "4.0.3",
    "zod": "3.25.32",
    "@apirequest/data": "workspace:^",
    "@apirequest/js-sandbox": "workspace:^"
  },
  "devDependencies": {
    "@relmify/jest-fp-ts": "2.1.1",
    "@types/lodash-es": "4.17.12",
    "@types/papaparse": "5.5.2",
    "@types/qs": "6.15.1",
    "fp-ts": "2.16.11",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM"],
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@apirequest/common": ["../apirequest-common/src/index.ts"],
      "@apirequest/common/*": ["../apirequest-common/src/*"],
      "@app/platform/*": ["./src/platform/*"],
      "@app/services/*": ["./src/services/*"],
      "@app/components/*": ["./src/components/*"],
      "@app/composables/*": ["./src/composables/*"],
      "@app/helpers/*": ["./src/helpers/*"],
      "@app/api/*": ["./src/api/*"]
    },
    "types": ["vite/client", "unplugin-icons/types/vue"]
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.tsx", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

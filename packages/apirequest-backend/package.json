{
  "name": "apirequest-backend",
  "version": "2026.10.0",
  "description": "",
  "author": "API Request contributors",
  "private": true,
  "license": "UNLICENSED",
  "files": [
    "prisma",
    "prisma.config.ts",
    "dist"
  ],
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "pnpm --filter @apirequest/runner build && nest build",
    "generate-gql-sdl": "cross-env GQL_SCHEMA_EMIT_LOCATION='../../../../gql-gen/backend-schema.gql' GENERATE_GQL_SCHEMA=true WHITELISTED_ORIGINS='' nest start",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "postinstall": "cross-env DATABASE_URL=postgresql://placeholder:placeholder@localhost:5432/placeholder prisma generate && pnpm run generate-gql-sdl",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "do-test": "pnpm run test"
  },
  "dependencies": {
    "@apirequest/data": "workspace:*",
    "@apirequest/runner": "workspace:^",
    "@apollo/server": "5.5.1",
    "@as-integrations/express5": "1.1.2",
    "@nestjs/apollo": "13.4.5",
    "@nestjs/common": "11.2.1",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.1",
    "@nestjs/graphql": "13.4.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.0",
    "@nestjs/platform-express": "11.2.1",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@xmldom/xmldom": "0.8.15",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "compression": "1.8.1",
    "cookie": "1.1.1",
    "cookie-parser": "1.4.7",
    "cron": "4.4.0",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "fp-ts": "2.16.11",
    "graphql": "16.14.0",
    "graphql-query-complexity": "1.1.1",
    "graphql-redis-subscriptions": "2.7.0",
    "graphql-subscriptions": "3.0.0",
    "io-ts": "2.2.22",
    "jsonpath-plus": "11.3.0",
    "morgan": "1.11.0",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.0",
    "prisma": "7.9.1",
    "quickjs-emscripten": "0.31.0",
    "reflect-metadata": "0.2.2",
    "rimraf": "6.1.3",
    "rxjs": "7.8.2",
    "socks": "2.8.7",
    "undici": "7.30.1",
    "ws": "8.21.0",
    "xpath": "0.0.36"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.1",
    "@relmify/jest-fp-ts": "2.1.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.3",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.1",
    "@types/ws": "8.18.2",
    "@typescript-eslint/eslint-plugin": "8.67.0",
    "@typescript-eslint/parser": "8.67.0",
    "cross-env": "10.1.0",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.11.0",
    "jest": "30.4.2",
    "jest-mock-extended": "4.0.1",
    "prettier": "3.9.6",
    "source-map-support": "0.5.21",
    "supertest": "7.2.2",
    "ts-jest": "29.4.12",
    "ts-loader": "9.6.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "setupFilesAfterEnv": [
      "../jest.setup.js"
    ],
    "preset": "ts-jest",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "diagnostics": false
        }
      ]
    },
    "clearMocks": true,
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageProvider": "v8",
    "rootDir": "src",
    "moduleNameMapper": {
      "^src/(.*)$": "<rootDir>/$1"
    }
  }
}
